<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="scanner_background">#101519</color>
    <color name="scanner_surface">#1D252B</color>
    <color name="scanner_surface_high">#2B363E</color>
    <color name="scanner_primary">#8EDACB</color>
    <color name="scanner_on_primary">#00382F</color>
    <color name="scanner_on_surface">#F0F5F7</color>
    <color name="scanner_secondary_text">#BECBD2</color>
    <color name="scanner_outline">#52616B</color>
    <color name="scanner_error">#FFB4AB</color>

    <!-- Explicit Material widgets let the two screens keep their existing Activity/GL lifecycle. -->
    <style name="Theme.Scanner" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/scanner_primary</item>
        <item name="colorPrimaryVariant">@color/scanner_on_primary</item>
        <item name="colorOnPrimary">@color/scanner_on_primary</item>
        <item name="colorSecondary">@color/scanner_primary</item>
        <item name="colorOnSecondary">@color/scanner_on_primary</item>
        <item name="colorSurface">@color/scanner_surface</item>
        <item name="colorOnSurface">@color/scanner_on_surface</item>
        <item name="colorError">@color/scanner_error</item>
        <item name="android:colorBackground">@color/scanner_background</item>
        <item name="android:windowBackground">@color/scanner_background</item>
        <item name="android:textColorPrimary">@color/scanner_on_surface</item>
        <item name="android:textColorSecondary">@color/scanner_secondary_text</item>
        <item name="android:colorAccent">@color/scanner_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.Scanner.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Scanner.Dialog</item>
    </style>

    <style name="ThemeOverlay.Scanner.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Scanner.Dialog</item>
    </style>
    <style name="ShapeAppearance.Scanner.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="Widget.Scanner.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Scanner.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/scanner_outline</item>
    </style>
    <style name="Widget.Scanner.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/scanner_on_surface</item>
        <item name="cornerRadius">24dp</item>
    </style>
</resources>
