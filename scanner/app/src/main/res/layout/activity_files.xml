<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scanner_background">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            app:title="@string/scans_title"
            app:titleTextColor="@color/scanner_on_surface">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Scanner.IconButton"
                android:id="@+id/settings"
                android:layout_gravity="end"
                android:contentDescription="@string/settings"
                app:icon="@drawable/ic_settings" />
        </com.google.android.material.appbar.MaterialToolbar>

        <TextView
            android:id="@+id/library_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="@string/library_hint"
            android:textColor="@color/scanner_secondary_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="vertical"
        android:background="@color/scanner_surface_high"
        android:visibility="gone">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="18sp"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Scanner.IconButton"
                android:id="@+id/close_selection"
                android:contentDescription="@string/close_selection"
                app:icon="@drawable/ic_ui_close" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Scanner.IconButton"
                android:id="@+id/position"
                android:contentDescription="@string/action_show_location"
                android:visibility="gone"
                app:icon="@drawable/ic_position_small" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Scanner.IconButton"
                android:id="@+id/share"
                android:contentDescription="@string/share_via"
                app:icon="@drawable/ic_share_small" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Scanner.IconButton"
                android:id="@+id/rename"
                android:contentDescription="@string/action_rename"
                app:icon="@drawable/ic_rename_small" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Scanner.IconButton"
                android:id="@+id/delete"
                android:contentDescription="@string/delete"
                app:iconTint="@color/scanner_error"
                app:icon="@drawable/ic_delete_small" />
        </LinearLayout>
    </LinearLayout>

    <GridView
        android:id="@+id/list"
        android:layout_below="@id/header"
        android:layout_above="@+id/layout_menu_action"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="2"
        android:padding="12dp"
        android:horizontalSpacing="12dp"
        android:verticalSpacing="12dp"
        android:stretchMode="columnWidth"
        android:clipToPadding="false"
        android:listSelector="@android:color/transparent" />

    <ScrollView
        android:id="@+id/library_message_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_above="@id/layout_menu_action"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp"
                android:gravity="center"
                android:text="@string/empty_scans_guidance"
                android:textSize="18sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/scanner_secondary_text"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="16dp"
                android:text="@string/policy_accepted"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Scanner.OutlinedButton"
                android:id="@+id/service_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="@string/action_cancel"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@id/layout_menu_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="end"
        android:padding="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/new_scan"
            app:icon="@drawable/ic_ui_add"
            app:cornerRadius="20dp" />
    </LinearLayout>
</RelativeLayout>
