<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.lvonasek.gles.GLESSurfaceView
        android:id="@+id/gl_surface_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="top"/>

    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/ar_hand_layout"
        android:visibility="gone"
        android:clipChildren="false">

        <com.lvonasek.arcore3dscanner.main.HandMotionView
            android:id="@+id/ar_hand_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foregroundGravity="center"
            android:src="@drawable/ic_hand_phone"
            android:scaleType="center"/>

    </FrameLayout>

    <com.lvonasek.arcore3dscanner.main.DistanceMeasuring
        android:id="@+id/distance"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="top" />

    <include layout="@layout/view_editor"/>

    <LinearLayout
        android:id="@+id/layout_wait"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:padding="16dp"
        android:layout_margin="12dp"
        android:background="@drawable/surface_scan_panel"
        android:visibility="gone" >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/wait"
            android:textColor="@android:color/white"
            android:accessibilityLiveRegion="polite"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_undo"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:padding="8dp"
        android:layout_margin="12dp"
        android:background="@drawable/surface_scan_panel"
        android:visibility="gone" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Scanner.OutlinedButton"
            android:id="@+id/undo_back_fast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\u00AB"
            android:contentDescription="@string/scan_rewind_back_fast"
            android:maxLines="1"
            android:layout_margin="2dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Scanner.OutlinedButton"
            android:id="@+id/undo_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\u2039"
            android:contentDescription="@string/scan_rewind_back"
            android:maxLines="1"
            android:layout_margin="2dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Scanner.OutlinedButton"
            android:id="@+id/undo_fwd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\u203A"
            android:contentDescription="@string/scan_rewind_forward"
            android:maxLines="1"
            android:layout_margin="2dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Scanner.OutlinedButton"
            android:id="@+id/undo_fwd_fast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\u00BB"
            android:contentDescription="@string/scan_rewind_forward_fast"
            android:maxLines="1"
            android:layout_margin="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Scanner.OutlinedButton"
            android:id="@+id/undo_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@android:string/cancel"
            android:maxLines="1"
            android:layout_margin="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/undo_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@android:string/ok"
            android:maxLines="1"
            android:layout_margin="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_quickmenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/layout_rec"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/surface_scan_panel"
        android:visibility="gone">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/photo_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="5dp"
            android:text="@string/photo_mode"/>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/show_normals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="5dp"
            android:text="@string/show_normals"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_rec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="12dp"
        android:padding="12dp"
        android:background="@drawable/surface_scan_panel">

        <TextView
            android:id="@+id/scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/wait"
            android:textSize="14sp"
            android:textColor="@color/scanner_secondary_text"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/scan_pause_short"
                android:contentDescription="@string/action_pause_scan" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Scanner.OutlinedButton"
                android:id="@+id/save_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_weight="1"
                android:text="@string/scan_finish_short"
                android:contentDescription="@string/action_finish_scan" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/undo_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:contentDescription="@string/action_rewind_scan"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo" />

            <ImageButton
                android:id="@+id/clear_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:tint="@color/scanner_error"
                android:contentDescription="@string/action_discard_scan"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete" />

            <ImageButton
                android:id="@+id/view_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:contentDescription="@string/action_scan_options"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_up" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_view"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:padding="8dp"
        android:layout_margin="12dp"
        android:background="@drawable/surface_scan_panel">

        <ImageButton
            android:id="@+id/orbit_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:padding="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_orbit_view"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_modeorbit" />

        <ImageButton
            android:id="@+id/topview_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:padding="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_top_view"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mode2d" />

        <ImageButton
            android:id="@+id/first_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:padding="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_first_person_view"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mode3d" />

        <ImageButton
            android:id="@+id/cardboard_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:padding="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_vr_view"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:src="@drawable/ic_cardboard" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_info"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_margin="12dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        android:background="@drawable/surface_scan_panel">

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/ic_memory"
            android:contentDescription="@string/scan_memory_label"/>

        <TextView
            android:text=""
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/info_left"/>

        <View
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="30dp"/>

        <TextView
            android:text=""
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/info_right"/>

        <View
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:background="@drawable/ic_battery_0"
            android:contentDescription="@string/scan_battery_label"
            android:id="@+id/info_battery"/>

    </LinearLayout>

    <TextView
        android:id="@+id/infolog"
        android:maxHeight="120dp"
        android:minHeight="48dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:background="@drawable/surface_scan_panel"
        android:padding="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:accessibilityLiveRegion="polite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_info"
        android:layout_alignParentStart="true"
        android:visibility="gone"
        android:text=""
        android:textColor="@color/scanner_on_surface"
        android:textSize="16sp"/>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_centerHorizontal="true"
        android:id="@+id/progressBar"
        android:indeterminate="true"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Scanner.IconButton"
        android:id="@+id/editor_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="10dp"
        android:visibility="gone"
        app:backgroundTint="@color/scanner_surface"
        app:icon="@drawable/ic_editor"
        android:contentDescription="@string/action_edit_model" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Scanner.IconButton"
        android:id="@+id/thumbnail_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="10dp"
        android:visibility="gone"
        app:backgroundTint="@color/scanner_surface"
        app:icon="@drawable/ic_share"
        android:contentDescription="@string/action_share_model" />

</RelativeLayout>
