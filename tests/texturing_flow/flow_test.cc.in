static std::string diagnostic;
static void logError(const char* format, ...) {
    char buffer[1024]; va_list args; va_start(args, format);
    vsnprintf(buffer, sizeof(buffer), format, args); va_end(args);
    diagnostic = buffer;
}
#define LOGE(...) logError(__VA_ARGS__)
#define LOGI(...) ((void)0)

// FAILURE-INJECTED BOUNDARIES: Tango C API, texture-alpha I/O, analyser, Poisson,
// scan clearing and binder/render integration. C API structs and GLM are real.
static std::string failure, badOutput;
static int contexts = 0, configs = 0, meshes = 0, updates = 0, saves = 0;
static int alphaImages = 0;
static int streamedExports = 0;
static std::string lastStreamAsset;
static std::function<void()> exportBoundaryCheck;
static int configCreates = 0;
static std::map<std::string, int32_t> options;
static int failUpdate = 0;
static bool throws = false;
static std::string poissonPath;
static bool externalFixture = false;
static std::vector<std::vector<unsigned char>> expectedFrames;
static const std::string validObj = "\n# keep\n  v 1.123456789012345 2.23456789012345 3.3456789012345 1\n"
    "v 0 0 0\nv 1 1 1\nvn 0.123456789012345 0.23456789012345 0.3456789012345\n"
    "vt 0.123456789012345 0.987654321098765\nf 1/1/1 2/1/1 3/1/1\n";
static void writeFile(const std::string& path, const std::string& content) { std::ofstream(path) << content; }
static std::string readFile(const std::string& path) { std::ifstream in(path); return std::string(std::istreambuf_iterator<char>(in), {}); }
struct _Tango3DR_Config {};
struct _Tango3DR_TexturingContext { int frames = 0; };
static Tango3DR_Status status(const char* point) { return failure == point ? TANGO_3DR_ERROR : TANGO_3DR_SUCCESS; }
static void allocateMesh(Tango3DR_Mesh* mesh) {
    *mesh = {}; mesh->num_vertices = 3; mesh->num_faces = 1;
    mesh->vertices = new Tango3DR_Vector3[3]{}; mesh->faces = new Tango3DR_Face[1]{}; ++meshes;
}
extern "C" {
Tango3DR_Config Tango3DR_Config_create(Tango3DR_ConfigType) {
    ++configCreates; options.clear();
    if (failure == "config") return nullptr;
    ++configs; return new _Tango3DR_Config;
}
Tango3DR_Status Tango3DR_Config_destroy(Tango3DR_Config config) { assert(config); delete config; --configs; return status("config_destroy"); }
Tango3DR_Status Tango3DR_Config_setInt32(Tango3DR_Config, const char* key, int32_t value) { options[key] = value; return status(key); }
Tango3DR_Status Tango3DR_Config_setDouble(Tango3DR_Config, const char* key, double) { return status(key); }
Tango3DR_TexturingContext Tango3DR_TexturingContext_create(Tango3DR_Config, const Tango3DR_Mesh*) {
#if SCANNER_MODERN
    // Contract-enforcing boundary, not a stand-in claim of real backend execution.
    assert(options["texturing_backend"] == 0 && options["mesh_simplification_factor"] == 1);
    assert(options["texture_size"] >= 16 && options["texture_size"] <= 4096);
    assert(options["max_num_textures"] >= 0 && options["max_num_textures"] <= 8);
    assert(uint64_t(options["max_num_textures"]) * options["texture_size"] * options["texture_size"] <= 16777216);
#endif
    if (failure == "context") return nullptr;
    ++contexts; return new _Tango3DR_TexturingContext;
}
Tango3DR_Status Tango3DR_TexturingContext_destroy(Tango3DR_TexturingContext context) {
    assert(context); delete context; --contexts; return status("context_destroy");
}
Tango3DR_Status Tango3DR_TexturingContext_setColorCalibration(Tango3DR_TexturingContext, const Tango3DR_CameraCalibration*) { return status("calibration"); }
Tango3DR_Status Tango3DR_ReconstructionContext_setColorCalibration(Tango3DR_ReconstructionContext, const Tango3DR_CameraCalibration*) { return TANGO_3DR_SUCCESS; }
Tango3DR_Status Tango3DR_Mesh_loadFromObj(const char*, Tango3DR_Mesh* mesh) {
    allocateMesh(mesh); if (failure == "empty") mesh->num_faces = 0; return status("load");
}
Tango3DR_Status Tango3DR_Mesh_destroy(Tango3DR_Mesh* mesh) {
    if (mesh->vertices) --meshes;
    delete[] mesh->vertices; delete[] mesh->faces; *mesh = {}; return status("mesh_destroy");
}
Tango3DR_Status Tango3DR_updateTexture(Tango3DR_TexturingContext context, const Tango3DR_ImageBuffer* image, const Tango3DR_Pose* pose) {
    const unsigned dimension = externalFixture ? 64 : 4;
    assert(image->data && image->width == dimension && image->height == dimension && image->stride == dimension);
    assert(image->format == TANGO_3DR_HAL_PIXEL_FORMAT_YCrCb_420_SP && pose->orientation[3] == 1);
    if (externalFixture) {
        assert(updates < int(expectedFrames.size()));
        assert(std::equal(expectedFrames[updates].begin(), expectedFrames[updates].end(), image->data));
        assert(std::fabs(pose->translation[0] - .08 * (updates - 1)) < 1e-7);
        assert(pose->translation[1] == 0 && pose->translation[2] == 0);
        assert(pose->orientation[0] == 0 && pose->orientation[1] == 0 && pose->orientation[2] == 0);
    }
    volatile unsigned char last = image->data[dimension * dimension * 3 / 2 - 1]; (void)last; ++updates;
    if (throws) throw std::runtime_error("injected update exception");
    ++context->frames;
    return (failUpdate == updates) ? TANGO_3DR_ERROR : status("update");
}
Tango3DR_Status Tango3DR_getTexturedMesh(Tango3DR_TexturingContext context, Tango3DR_Mesh* mesh) {
#if SCANNER_MODERN
    if (!context->frames) return TANGO_3DR_ERROR;
#endif
    allocateMesh(mesh); return status("get");
}
Tango3DR_Status Tango3DR_Mesh_saveToObj(const Tango3DR_Mesh*, const char* path) {
    ++saves;
    if (failure == "save") return TANGO_3DR_ERROR;
    if (failure == "missing_output") { remove(path); return TANGO_3DR_SUCCESS; }
    writeFile(path, badOutput.empty() ? validObj : badOutput); return TANGO_3DR_SUCCESS;
}
}
namespace oc {
#if SCANNER_MODERN
// Inject only the large-export boundary here. Real codec, visibility and
// full-geometry tests for this backend live in tests/dataset_texturing.
bool ExportDatasetTexturedObj(const std::string&, const std::string& output,
        Dataset*, const DatasetTextureSettings& options,
        const DatasetTextureProgress& progress, DatasetTextureReport& report) {
    ++streamedExports;
    if (exportBoundaryCheck) exportBoundaryCheck();
    assert(options.textureSize == 2048 && options.textureCount == 4);
    if (throws) throw std::runtime_error("injected streaming export exception");
    if (failure == "missing_output") { remove(output.c_str()); return true; }
    if (!failure.empty()) { report.error = "Injected streaming texturing failure"; return false; }
    writeFile(output,badOutput.empty() ? validObj : badOutput);
    lastStreamAsset = output + ".asset";
    writeFile(lastStreamAsset,"injected texture resource");
    report.faces = report.observedFaces = 1;
    report.artifacts.push_back(output);
    report.artifacts.push_back(lastStreamAsset);
    progress("IMAGE",1);
    return true;
}
#endif
class Image {
public:
    static bool JPG2YUV(std::string, unsigned char*, int, int);
    int GetWidth() { return 4; } int GetHeight() { return 4; }
    bool IsValid() { return failure != "alpha_read"; }
    bool Write(std::string) { return failure != "alpha_write"; }
    int GetColor(int, int) { return 0; }
    void DrawPixel(int, int, glm::ivec4) {}
    std::string GetName() { return "injected-texture"; }
};
struct Mesh {
    Image* image; bool imageOwner; std::vector<glm::vec3> vertices;
    void Destroy() { if (image) { delete image; image = nullptr; --alphaImages; } }
};
class File3d {
public:
    File3d(std::string, bool) {}
    void ReadModel(int, std::vector<Mesh>& out) { ++alphaImages; out.push_back({new Image, true, {glm::vec3(0)}}); }
};
}
