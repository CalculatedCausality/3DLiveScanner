// PRODUCTION_WRAPPER
// FAILURE-INJECTED libc/decoder boundaries, restricted to extracted definitions.
static std::string ioFailure;
static int testFseek(FILE* f, long n, int origin) { return ioFailure == "seek" ? -1 : fseek(f, n, origin); }
static long testFtell(FILE* f) { return ioFailure == "tell" ? -1 : ftell(f); }
static size_t testFread(void* p, size_t s, size_t n, FILE* f) { return ioFailure == "read" ? 0 : fread(p, s, n, f); }
static int testFclose(FILE* f) { int result = fclose(f); return ioFailure == "close" ? EOF : result; }
static size_t testFwrite(const void* p, size_t s, size_t n, FILE* f) { return ioFailure == "write" ? 0 : fwrite(p, s, n, f); }
static int testFflush(FILE* f) { return ioFailure == "flush" ? EOF : fflush(f); }
static int testFsync(int fd) { return ioFailure == "sync" ? -1 : fsync(fd); }
static int testRename(const char* a, const char* b) { return ioFailure == "rename" ? -1 : rename(a, b); }
static int testMkstemp(char* path) { return ioFailure == "temporary" ? -1 : mkstemp(path); }
static int testMkstemps(char* path, int suffix) { return ioFailure == "temporary" ? -1 : mkstemps(path, suffix); }
static tjhandle testInitDecompress() { return ioFailure == "decoder" ? nullptr : tjInitDecompress(); }
#define fseek testFseek
#define ftell testFtell
#define fread testFread
#define fclose testFclose
#define fwrite testFwrite
#define fflush testFflush
#define fsync testFsync
#define rename testRename
#define mkstemp testMkstemp
#define mkstemps testMkstemps
#define tjInitDecompress testInitDecompress
// PRODUCTION_DEFINITIONS
#undef fseek
#undef ftell
#undef fread
#undef fclose
#undef fwrite
#undef fflush
#undef fsync
#undef rename
#undef mkstemp
#undef mkstemps
#undef tjInitDecompress

static int descriptors() {
    DIR* dir = opendir("/proc/self/fd"); assert(dir); int count = 0;
    while (readdir(dir)) ++count;
    closedir(dir); return count;
}

// Real JPEG encoder/decoder, with a reference implementing the old 444 packing.
static void jpegFile(const std::string& path, int width, int height, int sampling) {
    std::vector<unsigned char> rgb(width * height * 3);
    for (size_t i = 0; i < rgb.size(); ++i) rgb[i] = static_cast<unsigned char>(i * 37);
    tjhandle handle = tjInitCompress(); assert(handle);
    unsigned char* compressed = nullptr; unsigned long size = 0;
    assert(tjCompress2(handle, rgb.data(), width, 0, height, TJPF_RGB, &compressed, &size, sampling, 90, TJFLAG_FASTDCT) == 0);
    FILE* file = fopen(path.c_str(), "wb"); assert(file);
    assert(fwrite(compressed, 1, size, file) == size); assert(fclose(file) == 0);
    tjFree(compressed); tjDestroy(handle);
}
static void codecTest(const std::string& dir) {
    for (int width : {4, 6, 16}) {
        const std::string path = dir + "/codec.jpg";
        jpegFile(path, width, 4, TJSAMP_444);
        std::string compressed = readFile(path);
        size_t pixels = width * 4;
        std::vector<unsigned char> planes(pixels * 3), actual(pixels * 3 / 2 + 16, 0xA5), expected(pixels * 3 / 2);
        tjhandle decoder = tjInitDecompress(); assert(decoder);
        assert(tjDecompressToYUV2(decoder, reinterpret_cast<unsigned char*>(&compressed[0]), compressed.size(),
            planes.data(), width, 1, 4, TJFLAG_FASTDCT | TJFLAG_FASTUPSAMPLE) == 0);
        tjDestroy(decoder);
        std::copy(planes.begin(), planes.begin() + pixels, expected.begin());
        for (int y = 0; y < 2; ++y) for (int x = 0; x < width; x += 2) {
            expected[pixels + y * width + x] = planes[2 * pixels + 2 * y * width + x];
            expected[pixels + y * width + x + 1] = planes[pixels + 2 * y * width + x + 1];
        }
        assert(oc::Image::JPG2YUV(path, actual.data(), width, 4));
        assert(std::equal(expected.begin(), expected.end(), actual.begin()));
        for (size_t i = expected.size(); i < actual.size(); ++i) assert(actual[i] == 0xA5);
        auto reject = [&]() { std::fill(actual.begin(), actual.end(), 0xA5); assert(!oc::Image::JPG2YUV(path, actual.data(), width, 4)); for (auto c : actual) assert(c == 0xA5); };
        for (int sampling : {TJSAMP_420, TJSAMP_422, TJSAMP_GRAY}) { jpegFile(path, width, 4, sampling); reject(); }
        jpegFile(path, width + 2, 4, TJSAMP_444); reject();
        writeFile(path, compressed.substr(0, compressed.size() - 20)); reject();
        writeFile(path, "not jpeg"); reject(); writeFile(path, ""); reject(); remove(path.c_str()); reject();
    }
    unsigned char data[24];
    assert(!oc::Image::JPG2YUV("unused", data, 3, 4));
    assert(!oc::Image::JPG2YUV("unused", data, INT_MAX, 4));
    assert(!oc::Image::JPG2YUV("unused", nullptr, 4, 4));
    // Concurrent conversions exercise local FILE/decoder ownership with real codec data.
    jpegFile(dir + "/parallel.jpg", 4, 4, TJSAMP_444);
    int before = descriptors();
    for (std::string point : {"seek", "tell", "read", "close", "decoder"}) {
        ioFailure = point;
        assert(!oc::Image::JPG2YUV(dir + "/parallel.jpg", data, 4, 4));
        assert(descriptors() == before);
    }
    ioFailure.clear();
    auto decode = [&]() { for (int i = 0; i < 20; ++i) { unsigned char out[24]; assert(oc::Image::JPG2YUV(dir + "/parallel.jpg", out, 4, 4)); } };
    std::thread a(decode), b(decode); a.join(); b.join();
}
static void clean() { assert(contexts == 0 && configs == 0 && meshes == 0 && alphaImages == 0); }
static void reset() { clean(); failure.clear(); badOutput.clear(); diagnostic.clear(); lastStreamAsset.clear(); exportBoundaryCheck={}; updates = saves = failUpdate = streamedExports = 0; throws = false; }
static void unlockCheck(oc::App& app) {
    assert(!app.offline_export.load());
    assert(app.texturing_result_mutex.try_lock()); app.texturing_result_mutex.unlock();
    assert(app.reconstruction.locks == app.reconstruction.unlocks);
    assert(app.reconstruction.binder.try_lock()); app.reconstruction.binder.unlock();
    assert(app.reconstruction.render_mutex_.try_lock()); app.reconstruction.render_mutex_.unlock();
    assert(!app.reconstruction.texturize.Context()); clean();
}
static void suppliedDatasetTest(const std::string& directory) {
    reset();
    oc::Dataset dataset(directory);
    int count = 0, width = 0, height = 0;
    double cx = 0, cy = 0, fx = 0, fy = 0;
    dataset.ReadState(count, width, height, cx, cy, fx, fy);
    assert(count == 3 && width == 64 && height == 64 && cx == 32 && cy == 32 && fx == 80 && fy == 80);
    const size_t pixels = width * height;
    for (int frame = 0; frame < count; ++frame) {
        const std::string path = dataset.GetFileName(frame, ".jpg");
        std::string jpeg = readFile(path);
        assert(!jpeg.empty());
        std::vector<unsigned char> legacy(pixels * 3), actual(pixels * 3 / 2);
        tjhandle decoder = tjInitDecompress(); assert(decoder);
        assert(tjDecompressToYUV2(decoder, reinterpret_cast<unsigned char*>(&jpeg[0]), jpeg.size(),
                legacy.data(), width, 4, height, TJFLAG_FASTDCT | TJFLAG_FASTUPSAMPLE) == 0);
        tjDestroy(decoder);
        // The original in-place JPG2YUV loop, valid for this fixture's 444 / aligned width.
        for (int y = 0; y < height / 2; ++y) {
            size_t offset = pixels + y * width, source = pixels + y * 2 * width;
            if (offset != source) memcpy(legacy.data() + offset, legacy.data() + source, width);
            for (int x = 0; x < width; x += 2) legacy[offset + x] = legacy[pixels + source + x];
        }
        legacy.resize(pixels * 3 / 2);
        assert(oc::Image::JPG2YUV(path, actual.data(), width, height));
        assert(actual == legacy);
        expectedFrames.push_back(legacy);
    }
    externalFixture = true;
    {
        oc::TangoTexturize wrapper;
        // Mesh load/context/update remain explicitly injected C API boundaries.
        assert(wrapper.Init("injected", true, false));
        assert(wrapper.ApplyFrames(&dataset));
        assert(updates == 3);
    }
    clean();
    puts("PASS: supplied synthetic legacy dataset, 3 x 64x64 JPEG444 frames, exact old NV21 bytes and translated poses at update boundary");
}
int main(int argc, char** argv) {
    assert(argc == 2 || argc == 3); std::string dir = argv[1]; codecTest(dir);
    oc::Dataset dataset(dir);
    auto fixture = [&]() {
        assert(dataset.WriteState(2, 4, 4, 2, 2, 4, 4));
        for (int i = 0; i < 2; ++i) {
            assert(dataset.WritePose(i, std::vector<glm::mat4>(oc::MAX_CAMERA, glm::mat4(1))));
            jpegFile(dataset.GetFileName(i, ".jpg"), 4, 4, TJSAMP_444);
        }
        writeFile(dir + "/rotation.txt", "-90");
    };
    fixture();
    {
        oc::TangoTexturize wrapper;
        assert(wrapper.Init("injected", true, false));
        assert(options["mesh_simplification_factor"] == (SCANNER_MODERN ? 1 : 10));
        assert(wrapper.Init("injected", true, true));
        assert(options["mesh_simplification_factor"] == (SCANNER_MODERN ? 1 : 5));
        assert(options["max_num_textures"] == 1 && options["texture_size"] == 4096);
        wrapper.SetTextureParams(7, 2048, 4);
        assert(wrapper.Init("injected", true, false));
        assert(options["mesh_simplification_factor"] == (SCANNER_MODERN ? 1 : 7));
        for (auto parameters : {std::pair<int,int>{16,8}, {4096,1}, {2048,4}, {4096,0}, {16,0}}) {
            wrapper.SetTextureParams(99, parameters.first, parameters.second);
            assert(wrapper.Init("injected", true, false));
            assert(options["texture_size"] == parameters.first && options["max_num_textures"] == parameters.second);
        }
        for (auto parameters : {std::pair<int,int>{15,1}, {4097,1}, {2048,5}, {4096,2}, {16,9}, {16,-1}, {INT_MAX,INT_MAX}}) {
            wrapper.SetTextureParams(99, parameters.first, parameters.second);
            int before = configCreates;
            assert(wrapper.Init("injected", true, false) == !SCANNER_MODERN);
#if SCANNER_MODERN
            clean(); assert(configCreates == before);
            assert(diagnostic.find("Unsupported texturing resource budget") != std::string::npos);
            assert(diagnostic.find("64 MiB") != std::string::npos);
#endif
        }
        wrapper.SetTextureParams(10, 2048, 4);
        assert(wrapper.Init("injected", true, false));
    }
    reset();
    {
        oc::TangoTexturize wrapper; assert(!wrapper.Context()); assert(wrapper.Camera().width == 0);
        assert(wrapper.Init("injected", true, false));
        assert(wrapper.Init("injected", true, false)); assert(contexts == 1);
        assert(wrapper.ApplyFrames(&dataset)); assert(updates == 2);
        assert(wrapper.Process(dir + "/wrapper.obj")); clean();
        for (std::string point : {"config", "texturing_backend", "max_num_textures", "mesh_simplification_factor", "texture_size", "min_resolution", "context", "config_destroy", "load", "empty", "mesh_destroy"}) {
            reset(); failure = point; assert(!wrapper.Init("injected", true, false)); clean();
        }
        for (std::string point : {"calibration", "update", "get", "save", "mesh_destroy", "context_destroy"}) {
            reset(); assert(wrapper.Init("injected", true, false));
            if (point != "calibration" && point != "update") assert(wrapper.ApplyFrames(&dataset));
            failure = point;
            if (point == "calibration" || point == "update") assert(!wrapper.ApplyFrames(&dataset));
            else assert(!wrapper.Process(dir + "/wrapper.obj"));
            clean();
        }
        reset(); assert(wrapper.Init("injected", true, false)); failUpdate = 2;
        assert(!wrapper.ApplyFrames(&dataset)); assert(updates == 2); clean();
        reset(); assert(wrapper.Init("injected", true, false)); throws = true;
        assert(!wrapper.ApplyFrames(&dataset)); clean();
        for (std::vector<int> frames : {std::vector<int>{}, {-1}, {2}}) {
            reset(); assert(wrapper.Init("injected", true, false)); assert(!wrapper.ApplyFrames(&dataset, frames)); clean();
        }
        for (int fault = 0; fault < 7; ++fault) {
            reset(); fixture(); assert(wrapper.Init("injected", true, false));
            if (fault == 0) remove((dir + "/state.txt").c_str());
            if (fault == 1) writeFile(dir + "/state.txt", "2 bad");
            if (fault == 2) writeFile(dir + "/state.txt", "2 2147483647 4 2 2 4 4");
            if (fault == 3) remove(dataset.GetFileName(0, ".mat").c_str());
            if (fault == 4) writeFile(dataset.GetFileName(0, ".mat"), "bad pose");
            if (fault == 5) assert(dataset.WritePose(0, std::vector<glm::mat4>(oc::MAX_CAMERA, glm::mat4(0))));
            if (fault == 6) remove(dataset.GetFileName(0, ".jpg").c_str());
            assert(!wrapper.ApplyFrames(&dataset)); clean();
        }
        reset(); fixture(); assert(wrapper.Init("injected", true, false));
    }
    clean(); // destructor cleans an unprocessed context
    fixture();
    const std::string input = dir + "/source.obj", output = dir + "/output.obj";
    writeFile(input, "SOURCE MUST SURVIVE");
    oc::App app; app.reconstruction.dataset = &dataset;
    for (std::string point : {"load", "config", "update", "get", "save", "missing_output", "empty_subset", "alpha_write", "alpha_read"}) {
        reset(); failure = point;
        assert(!app.Texturize(input, output, point == "alpha_write" || point == "alpha_read", point == "empty_subset"));
        assert(!app.texturing_error.empty());
        unlockCheck(app); assert(readFile(input) == "SOURCE MUST SURVIVE");
    }
    reset(); throws = true; assert(!app.Texturize(input, output, false, false)); unlockCheck(app);
    for (const std::string& malformed : {"\n", "v 1 2\nf 1 1 1\n", "v nan 2 3\nf 1 1 1\n", "v 1 2 3oops\nf 1 1 1\n", "v 1 2 3\nf a b c\n", "v 1 2 3\nf 1 1\n", "v 1 2 3\nf 1 1 2\n", "v 1 2 3\nf 1/x 1 1\n", "v 1 2 3\nf 1///1 1 1\n", "v 1 2 3\nvt broken\nf 1 1 1\n"}) {
        reset(); writeFile(output,"PRIOR OUTPUT"); badOutput = malformed;
        assert(!app.Texturize(input, output, false, false));
        assert(readFile(output) == (SCANNER_MODERN ? "PRIOR OUTPUT" : malformed)); unlockCheck(app);
        if (!lastStreamAsset.empty()) assert(access(lastStreamAsset.c_str(),F_OK) != 0);
    }
    for (bool poisson : {false, true}) for (bool twoPass : {false, true}) {
        reset(); fixture();
        app.reconstruction.paused = false;
        exportBoundaryCheck = [&] {
            assert(app.offline_export.load() && app.reconstruction.paused);
            assert(app.reconstruction.render_mutex_.try_lock());
            app.reconstruction.render_mutex_.unlock();
        };
        assert(app.Texturize(input, output, poisson, twoPass)); unlockCheck(app);
        assert(app.texturing_error.empty());
        assert(streamedExports == (SCANNER_MODERN && !poisson && !twoPass ? 1 : 0));
        if (!lastStreamAsset.empty()) {
            assert(readFile(lastStreamAsset) == "injected texture resource");
            remove(lastStreamAsset.c_str());
        }
        assert(readFile(input) == "SOURCE MUST SURVIVE");
        if (poisson) assert(poissonPath == output);
        std::string result = readFile(output);
        assert(result.find("vt 0.123456789012345 0.987654321098765") != std::string::npos);
        assert(result.find("vn ") != std::string::npos && result.find("# keep") != std::string::npos);
        std::istringstream lines(result); std::string line;
        while (std::getline(lines, line)) {
            std::istringstream fields(line); std::string kind; fields >> kind;
            if (kind == "v") { double x, y, z, w; fields >> x >> y >> z >> w;
                assert(std::fabs(x - 1.123456789012345) < 1e-14 && std::fabs(z - 3.3456789012345) < 1e-14 && w == 1); break; }
        }
    }
    reset(); writeFile(dir + "/rotation.txt", "0"); assert(app.Texturize(input, output, false, false));
    std::istringstream compass(readFile(output)); std::string compassLine;
    while (std::getline(compass, compassLine)) {
        std::istringstream fields(compassLine); std::string kind; fields >> kind;
        if (kind == "v") { double x, y, z; fields >> x >> y >> z;
            assert(std::fabs(x + 3.3456789012345) < 1e-14 && std::fabs(z - 1.123456789012345) < 1e-14); break; }
    }
    unlockCheck(app);
    if (!lastStreamAsset.empty()) remove(lastStreamAsset.c_str());
    int before = descriptors();
    for (std::string point : {"write", "flush", "sync", "rename", "temporary"}) {
        reset(); writeFile(output,"PRIOR OUTPUT"); ioFailure = point;
        assert(!app.Texturize(input, output, false, false));
        assert(readFile(output) == (SCANNER_MODERN ? "PRIOR OUTPUT" : validObj)); unlockCheck(app);
        if (!lastStreamAsset.empty()) assert(access(lastStreamAsset.c_str(),F_OK) != 0);
        assert(descriptors() == before);
    }
    ioFailure.clear();
    reset(); assert(!app.Texturize(input, input, false, false)); unlockCheck(app);
    assert(readFile(input) == "SOURCE MUST SURVIVE");
    DIR* files = opendir(dir.c_str()); assert(files);
    while (dirent* file = readdir(files)) {
        assert(std::string(file->d_name).find(".reorient-") == std::string::npos);
        assert(std::string(file->d_name).find(".texturing-") == std::string::npos);
    }
    closedir(files);
    puts("PASS: real codec pixels, validation, cleanup, bool statuses, RAII locks, atomic OBJ reorientation");
    if (argc == 3) suppliedDatasetTest(argv[2]);
}
